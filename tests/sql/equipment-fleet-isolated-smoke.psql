-- Run ONLY with psql against an isolated migrated PostgreSQL test database.
-- Database name must start with vacleaner_test_ (hard stop otherwise).
\set ON_ERROR_STOP on
select (current_database() ~ '^vacleaner_test_')::integer as safe_database \gset
\if :safe_database
\else
  \echo 'REFUSING: requires an isolated vacleaner_test_* database'
  \quit 3
\endif

begin;
set local statement_timeout = '10s';
do $$
declare
  v_unit public.vacleaner_equipment_units%rowtype;
  v_capacity integer;
  v_events bigint;
  v_result jsonb;
  v_actor uuid := '00000000-0000-4000-8000-000000000099';
begin
  select * into v_unit from public.vacleaner_equipment_units
    where status='ready' order by resource_code,unit_number limit 1;
  if not found then raise exception 'fixture_missing_ready_unit'; end if;
  select capacity into v_capacity from public.vacleaner_inventory
    where resource_code=v_unit.resource_code;
  select count(*) into v_events from public.vacleaner_equipment_unit_events
    where unit_id=v_unit.id;
  v_result := public.vacleaner_admin_set_equipment_unit_status(
    v_unit.id,'ready','idempotent fixture',v_actor);
  if v_result->>'changed' <> 'false' then
    raise exception 'same_status_not_idempotent: %',v_result;
  end if;
  if (select capacity from public.vacleaner_inventory
      where resource_code=v_unit.resource_code) is distinct from v_capacity then
    raise exception 'idempotent_call_changed_capacity';
  end if;
  if (select count(*) from public.vacleaner_equipment_unit_events
      where unit_id=v_unit.id) <> v_events then
    raise exception 'idempotent_call_created_event';
  end if;
  begin
    perform public.vacleaner_admin_set_equipment_unit_status(
      v_unit.id,'not_a_status','invalid fixture',v_actor);
    raise exception 'invalid_status_was_accepted';
  exception when others then
    if sqlerrm <> 'invalid_equipment_change' then raise; end if;
  end;
  if (select capacity from public.vacleaner_inventory
      where resource_code=v_unit.resource_code) is distinct from v_capacity then
    raise exception 'invalid_call_changed_capacity';
  end if;
  raise notice 'PASS equipment RPC idempotency, invalid input and capacity invariants';
end
$$;
rollback;
